SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATA_DIR=./data

# Base model for fine-tuning (HuggingFace model ID)
BASE_MODEL=unsloth/Llama-3.2-1B

# LoRA Configuration
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LEARNING_RATE=2e-4
TRAINING_EPOCHS=3
MAX_SEQ_LENGTH=512
BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4

# Auto-convert trained adapters to GGUF for llama.cpp
AUTO_CONVERT_GGUF=true

# Device auth (simple shared secret for local dev)
DEVICE_API_KEY=runanywhere-dev-key

# Logging
LOG_LEVEL=INFO
